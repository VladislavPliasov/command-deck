{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-profile.schema.json",
  "title": "Command Deck Tool Profile",
  "description": "Schema version 1.1 for Command Deck tool profiles. Adds optional `commands` (structured command/parameter metadata) and `verification.toolVersion` to the 1.0 profile. Versioning policy: schemaVersion matches ^1\\.[0-9]+$; readers accept any 1.x; writers stamp the current version; absent optional fields are omitted (never null). Structural compatibility is guaranteed; byte-identical re-serialization is not. NOTE: the Rust validator in src-tauri/src/registry/validation.rs is the authoritative superset of this schema. Constraints expressible here are encoded for early feedback; constraints that JSON Schema cannot express (tree-wide id uniqueness, sibling token/alias uniqueness, requires/conflicts reference integrity, positional order uniqueness, choices uniqueness, nesting depth <= 5, tree-total command caps) are enforced only in Rust. Unknown fields are tolerated on non-custom parameters for forward compatibility; for kind=custom the closed field set is enforced here and in Rust. Do not use keywords unsupported by the declared draft.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "tags",
    "integrationType",
    "executable",
    "discovery",
    "verification",
    "platforms",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.[0-9]+$",
      "description": "Schema major version 1 with additive minor versions."
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Unique, filesystem-safe identifier (used as the registry filename). Must not be a Windows reserved device name (CON, PRN, AUX, NUL, COM1-COM9, LPT1-LPT9) and must not end with a dot; these rules are enforced by the Rust validator."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "category": {
      "enum": [
        "Reconnaissance",
        "Scanning",
        "Web Application Security",
        "Exploitation",
        "Password Security Testing",
        "Wireless Security",
        "Network Security",
        "Privilege Escalation",
        "Post-Exploitation",
        "Active Directory and Windows Security",
        "Reverse Engineering",
        "Malware Analysis",
        "Digital Forensics",
        "Social Engineering",
        "Defensive Security",
        "other"
      ],
      "description": "Security domain from PRODUCT_SPECIFICATION.md section 5, verbatim, plus 'other'."
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "integrationType": {
      "enum": ["cli", "gui"]
    },
    "executable": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to the executable file. Required for locally registered tools in schema 1.x; a future catalog format may relax this."
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "enum": ["manual", "file-version"]
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["source", "discoveredAt"],
      "properties": {
        "source": {
          "enum": ["manual", "path-scan", "import"]
        },
        "discoveredAt": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "source"],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "partially-verified",
            "verified",
            "manually-configured",
            "incompatible"
          ]
        },
        "source": {
          "type": "string"
        },
        "toolVersion": {
          "type": "string",
          "description": "Tool version the metadata was originally authored or verified against. Historical reference only - not a compatibility guarantee. Never auto-populated."
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["windows", "linux", "macos"]
      }
    },
    "commands": {
      "type": "array",
      "maxItems": 200,
      "description": "Command/parameter metadata. Top-level entries are root commands; one entry may use token:null for direct/executable-level mode. Omitted entirely when absent.",
      "items": { "$ref": "#/$defs/commandSpecTop" },
      "contains": {
        "properties": { "token": { "type": "null" } },
        "required": ["token"]
      },
      "minContains": 0,
      "maxContains": 1
    },
    "documentationUrl": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Absolute http(s) URL only."
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "$defs": {
    "valueSpec": {
      "type": "object",
      "required": ["valueType"],
      "properties": {
        "valueType": {
          "enum": ["boolean", "string", "integer", "decimal", "enum", "file", "directory", "ip", "cidr", "domain", "port", "list", "custom"]
        },
        "choices": {
          "type": "array",
          "maxItems": 32,
          "items": { "type": "string", "minLength": 1 }
        },
        "default": { "type": "string", "maxLength": 200 },
        "multiple": { "type": "boolean" },
        "optional": { "type": "boolean" }
      },
      "allOf": [
        {
          "if": {
            "properties": { "valueType": { "const": "enum" } },
            "required": ["valueType"]
          },
          "then": {
            "required": ["choices"],
            "properties": { "choices": { "minItems": 1 } }
          }
        },
        {
          "if": {
            "not": {
              "properties": { "valueType": { "const": "enum" } },
              "required": ["valueType"]
            }
          },
          "then": { "properties": { "choices": false } }
        },
        {
          "if": {
            "properties": { "optional": { "const": true } },
            "required": ["optional"]
          },
          "then": { "properties": { "multiple": { "const": false } } }
        }
      ]
    },
    "parameterSpec": {
      "type": "object",
      "required": ["id", "kind", "label"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "kind": { "enum": ["flag", "option", "positional", "custom"] },
        "label": { "type": "string", "minLength": 1, "maxLength": 200 },
        "token": { "type": "string", "minLength": 1, "maxLength": 120 },
        "aliases": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        },
        "description": { "type": "string", "maxLength": 4000 },
        "syntax": { "type": "string", "maxLength": 200 },
        "value": { "$ref": "#/$defs/valueSpec" },
        "required": { "type": "boolean" },
        "repeatable": { "type": "boolean" },
        "requires": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "conflicts": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "examples": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 200 }
        },
        "versionConstraints": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "description": "Display-only version notes (syntax not validated)."
        },
        "order": { "type": "integer", "minimum": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "kind": { "const": "custom" } },
            "required": ["kind"]
          },
          "then": {
            "description": "Closed contract for custom parameters: exactly the documented fields, at least one of syntax/description.",
            "properties": {
              "id": true,
              "kind": true,
              "label": true,
              "token": true,
              "syntax": true,
              "description": true,
              "examples": true,
              "versionConstraints": true,
              "required": true,
              "repeatable": true,
              "requires": true,
              "conflicts": true,
              "value": false,
              "aliases": false,
              "order": false
            },
            "additionalProperties": false,
            "anyOf": [
              { "required": ["syntax"] },
              { "required": ["description"] }
            ]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "flag" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["token"],
            "properties": { "value": false }
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "option" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["token", "value"]
          }
        },
        {
          "if": {
            "properties": { "kind": { "const": "positional" } },
            "required": ["kind"]
          },
          "then": {
            "required": ["order", "value"],
            "properties": {
              "token": false,
              "repeatable": { "const": false }
            }
          }
        },
        {
          "if": {
            "properties": {
              "value": {
                "properties": { "optional": { "const": true } },
                "required": ["optional"]
              }
            },
            "required": ["value"]
          },
          "then": {
            "properties": { "kind": { "const": "option" } }
          }
        }
      ]
    },
    "commandSpecNested": {
      "type": "object",
      "required": ["id", "token", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "token": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "description": "Nested subcommands must have a non-null string token."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 4000 },
        "syntaxExamples": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 200 }
        },
        "versionConstraints": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "parameters": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/parameterSpec" }
        },
        "subcommands": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/commandSpecNested" }
        }
      }
    },
    "commandSpecTop": {
      "type": "object",
      "required": ["id", "token", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
        "token": {
          "type": ["string", "null"],
          "minLength": 1,
          "maxLength": 120,
          "description": "Literal argv token; null marks the direct/executable-level mode (at most one top-level entry). Always serialized."
        },
        "name": { "type": "string", "minLength": 1, "maxLength": 200 },
        "summary": { "type": "string", "maxLength": 300 },
        "description": { "type": "string", "maxLength": 4000 },
        "syntaxExamples": {
          "type": "array",
          "maxItems": 16,
          "items": { "type": "string", "maxLength": 200 }
        },
        "versionConstraints": {
          "type": "array",
          "maxItems": 8,
          "items": { "type": "string", "minLength": 1, "maxLength": 64 }
        },
        "parameters": {
          "type": "array",
          "maxItems": 100,
          "items": { "$ref": "#/$defs/parameterSpec" }
        },
        "subcommands": {
          "type": "array",
          "maxItems": 50,
          "items": { "$ref": "#/$defs/commandSpecNested" }
        }
      }
    }
  },
  "additionalProperties": true
}
