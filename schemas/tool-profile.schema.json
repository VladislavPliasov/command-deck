{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "tool-profile.schema.json",
  "title": "Command Deck Tool Profile",
  "description": "Schema version 1.0 for Command Deck tool profiles. Command grammar fields are intentionally deferred to a future schema version (Command Builder). Unknown fields are tolerated for forward compatibility within schema major version 1.",
  "type": "object",
  "required": [
    "schemaVersion",
    "id",
    "name",
    "category",
    "tags",
    "integrationType",
    "executable",
    "discovery",
    "verification",
    "platforms",
    "createdAt",
    "updatedAt"
  ],
  "properties": {
    "schemaVersion": {
      "type": "string",
      "const": "1.0"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$",
      "description": "Unique, filesystem-safe identifier (used as the registry filename). Must not be a Windows reserved device name (CON, PRN, AUX, NUL, COM1-COM9, LPT1-LPT9) and must not end with a dot; these rules are enforced by the Rust validator."
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "description": {
      "type": "string",
      "maxLength": 4000
    },
    "category": {
      "enum": [
        "Reconnaissance",
        "Scanning",
        "Web Application Security",
        "Exploitation",
        "Password Security Testing",
        "Wireless Security",
        "Network Security",
        "Privilege Escalation",
        "Post-Exploitation",
        "Active Directory and Windows Security",
        "Reverse Engineering",
        "Malware Analysis",
        "Digital Forensics",
        "Social Engineering",
        "Defensive Security",
        "other"
      ],
      "description": "Security domain from PRODUCT_SPECIFICATION.md section 5, verbatim, plus 'other'."
    },
    "tags": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 32
      }
    },
    "integrationType": {
      "enum": ["cli", "gui"]
    },
    "executable": {
      "type": "object",
      "required": ["name", "path"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "description": "Absolute path to the executable file. Required for locally registered tools in schema 1.0; a future catalog format may relax this."
        }
      }
    },
    "version": {
      "type": "object",
      "required": ["value", "source"],
      "properties": {
        "value": {
          "type": "string"
        },
        "source": {
          "enum": ["manual", "file-version"]
        }
      }
    },
    "discovery": {
      "type": "object",
      "required": ["source", "discoveredAt"],
      "properties": {
        "source": {
          "enum": ["manual", "path-scan", "import"]
        },
        "discoveredAt": {
          "type": "string"
        }
      }
    },
    "verification": {
      "type": "object",
      "required": ["status", "source"],
      "properties": {
        "status": {
          "enum": [
            "unverified",
            "partially-verified",
            "verified",
            "manually-configured",
            "incompatible"
          ]
        },
        "source": {
          "type": "string"
        }
      }
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": ["windows", "linux", "macos"]
      }
    },
    "documentationUrl": {
      "type": "string",
      "pattern": "^https?://",
      "description": "Absolute http(s) URL only."
    },
    "author": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "url": {
          "type": "string",
          "pattern": "^https?://"
        }
      }
    },
    "createdAt": {
      "type": "string"
    },
    "updatedAt": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
