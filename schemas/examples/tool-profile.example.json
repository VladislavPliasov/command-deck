{
  "schemaVersion": "1.1",
  "id": "nmap",
  "name": "Nmap",
  "description": "Network exploration tool and security / port scanner.",
  "category": "Scanning",
  "tags": ["network", "scanner", "ports"],
  "integrationType": "cli",
  "executable": {
    "name": "nmap.exe",
    "path": "C:\\Tools\\Nmap\\nmap.exe"
  },
  "version": {
    "value": "7.95.0.0",
